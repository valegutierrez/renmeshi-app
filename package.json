{
  "name": "renmeshi-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "build": "tsc -b && vite build",
    "test": "vitest run",
